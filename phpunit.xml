<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true">
    <!--
        Each suite must run on its own (see composer.json scripts).
        Both mu-plugins define wp_hash_password() and wp_check_password(),
        so only ONE can be loaded per PHP process - exactly like on a real site.
    -->
    <testsuites>
        <testsuite name="bcrypt">
            <file>tests/BcryptTest.php</file>
        </testsuite>
        <testsuite name="argon2id">
            <file>tests/Argon2idTest.php</file>
        </testsuite>
    </testsuites>
</phpunit>
